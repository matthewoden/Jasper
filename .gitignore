/bin/
/tmp/
/node_modules/
frontend/node_modules/
*.test
coverage.out
.DS_Store
.env
.env.local
# frontend/dist/ is populated by `npm run build` (Vite output).
# The .gitkeep was removed in Phase 3 cleanup; run `npm run build`
# before `make build` to populate this directory. It is not go:embedded
# directly — make build copies it to backend/internal/static/dist/.
frontend/dist/*

# TypeScript incremental build cache and emitted JS for config files
frontend/*.tsbuildinfo
frontend/vite.config.d.ts
frontend/vite.config.js
frontend/vitest.config.d.ts
frontend/vitest.config.js

# backend/internal/static/dist/ is populated by `make build` from
# frontend/dist/; a .keep placeholder is committed so //go:embed all:dist
# compiles on a fresh clone (before make build has run). The .gitkeep
# was removed in Phase 3 cleanup; this .keep replaces it.
backend/internal/static/dist/*
!backend/internal/static/dist/.keep

# Playwright E2E artifacts
frontend/e2e/.artifacts/
frontend/playwright-report/
frontend/test-results/
