/bin/
/tmp/
/node_modules/
frontend/node_modules/

# Stray tmp/ subdirs — air now writes to project_root/tmp/ (already covered by /tmp/
# above), but earlier configs put it under backend/tmp/ and frontend/tmp/ can
# appear when dev tooling spawns from frontend/. Keep these ignored defensively.
backend/tmp/
frontend/tmp/
*.test
coverage.out
.DS_Store
.env
.env.local
# frontend/dist/ is populated by `npm run build` (Vite output).
# The .gitkeep was removed in Phase 3 cleanup; run `npm run build`
# before `make build` to populate this directory. It is not go:embedded
# directly — make build copies it to backend/internal/static/dist/.
frontend/dist/*

# TypeScript incremental build cache and emitted JS for config files
frontend/*.tsbuildinfo
frontend/vite.config.d.ts
frontend/vite.config.js
frontend/vitest.config.d.ts
frontend/vitest.config.js

# backend/internal/static/dist/ is populated by `make build` from
# frontend/dist/; a .keep placeholder is committed so //go:embed all:dist
# compiles on a fresh clone (before make build has run). The .gitkeep
# was removed in Phase 3 cleanup; this .keep replaces it.
backend/internal/static/dist/*
!backend/internal/static/dist/.keep

# Playwright E2E artifacts
frontend/e2e/.artifacts/
frontend/playwright-report/
frontend/test-results/
/test-results/

# Local Claude Code / Vite caches — agent worktrees and build cache live here.
.claude/
.vite/

# Synthetic 5k-note vault for the cold-start perf gate
# benchmark. Populated by `make perf-vault`; never committed.
/_perf-vault/

# Regenerable local artifacts that kept reappearing as untracked clutter.
# backend/test-results/ is the Go-side sibling of the already-ignored
# frontend/test-results/. .parity-shots/ is written by phase26-divider-uat's
# SHOTS_DIR. scratchpad/ and agent-history.json are agent-local scratch.
backend/test-results/
/.parity-shots/
/scratchpad/
.planning/agent-history.json
