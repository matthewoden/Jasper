# Jasper's subgraph: how another system reads Jasper by id.
#
# Everything from DateTime to Action is graphos's shared Item contract,
# verbatim from api/graphql/graphos/item.graphql; contract_test.go holds it
# there. Root fields carry the jasper prefix because the shell subgraph owns
# the supergraph's item and items.
#
# Reads only. Writes go through REST and MCP, which accept the same ids.

extend schema
  @link(
    url: "https://specs.apollo.dev/federation/v2.3"
    import: ["@key", "@shareable"]
  )

"""
RFC 3339 timestamp, UTC.
"""
scalar DateTime

enum ItemStatus {
  OK
  UNKNOWN
  DELETED
}

"""
Output-only, so the supergraph is the union of every subgraph's values.
Each subgraph lists only the kinds it owns, plus FOREIGN for its stub.
"""
enum ItemKind {
  FOREIGN
}

"""
Anything a reference can point at. The id is the universal ref:
<ns>:<kind>/<native>.
"""
interface Item {
  id: ID!
  kind: ItemKind!
  status: ItemStatus!
  "Current title; for a DELETED item, the last one known."
  title: String!
  "Last modification; for a DELETED item, the deletion time."
  updatedAt: DateTime
}

"""
Anything a time lane can place. A run has startsAt; an event has both.
"""
interface Timed {
  startsAt: DateTime
  endsAt: DateTime
}

"""
Anything with a kind-specific state the shell colours through its per-kind
table: running, merged, active.
"""
interface Stateful {
  state: String
}

"""
Anything with a deep link into the owning UI or an external site.
"""
interface Linkable {
  url: String
}

"""
Anything whose owner offers actions right now. Each mutation names a
mutation on the owning subgraph that takes the item id as its only required
argument.
"""
interface Actionable {
  actions: [Action!]!
}

enum ActionKind {
  NAVIGATE
  MUTATE
  SPAWN
}

type Action @shareable {
  id: ID!
  label: String!
  kind: ActionKind!
  mutation: String!
}

extend enum ItemKind {
  NOTE
  BLOB
}

type Note implements Item @key(fields: "id") {
  id: ID!
  kind: ItemKind!
  status: ItemStatus!
  title: String!
  updatedAt: DateTime
  "Vault-relative path; for a DELETED note, the last one."
  path: String
  "The markdown as on disk. Null when the note is not OK."
  body: String
  "The first stretch of body text, at most 200 characters."
  excerpt: String
  "Every target this note references, in universal form."
  refs: [String!]!
  "Notes referencing this one, by title or by id."
  backlinks: [Backlink!]!
}

type Blob implements Item @key(fields: "id") {
  id: ID!
  kind: ItemKind!
  status: ItemStatus!
  title: String!
  updatedAt: DateTime
  mime: String
  size: Int
  "Live paths holding these bytes."
  paths: [String!]!
  "For a DELETED blob whose bytes changed in place, the id that took over."
  replacedBy: ID
}

"""
A reference into another system, returned as written. Jasper can say who
references it, not what it is.
"""
type ForeignRef implements Item @shareable {
  id: ID!
  kind: ItemKind!
  status: ItemStatus!
  title: String!
  updatedAt: DateTime
  namespace: String!
}

type Backlink {
  source: Note!
  "The alias the first occurrence shows, or empty."
  display: String!
  embed: Boolean!
}

type Query {
  "Resolve one ref: a universal ref, a bare note or blob id, or jasper:title/<title>."
  jasperItem(id: ID!): Item
  "Resolve several refs at once; order matches the request, missing as null."
  jasperItems(ids: [ID!]!): [Item]!
  "Who references a target, native or foreign."
  jasperBacklinks(id: ID!): [Backlink!]
  "Notes by title and body, blobs by file name."
  jasperSearch(q: String!, limit: Int = 20): [Item!]
}

enum ItemChangeKind {
  CREATED
  UPDATED
  DELETED
  MOVED
  REFS_CHANGED
}

type ItemChange {
  "The universal ref of the item that changed."
  id: ID!
  change: ItemChangeKind!
  at: DateTime!
}

type Subscription {
  "Every change to a note the server broadcasts, as it happens."
  itemChanged: ItemChange!
}
