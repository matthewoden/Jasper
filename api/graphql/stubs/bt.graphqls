# Stand-in for a BusyTown subgraph. Used only by compose-check.
extend schema
  @link(url: "https://specs.apollo.dev/federation/v2.3", import: ["@key", "@shareable"])

scalar DateTime

enum ItemStatus {
  OK
  UNKNOWN
  DELETED
}

enum ItemKind {
  NOTE
  BLOB
  FOREIGN
}

interface Item {
  id: ID!
  kind: ItemKind!
  status: ItemStatus!
  title: String!
  updatedAt: DateTime
}

type Task implements Item @key(fields: "id") {
  id: ID!
  kind: ItemKind!
  status: ItemStatus!
  title: String!
  updatedAt: DateTime
  done: Boolean!
}

type Query {
  task(id: ID!): Task
}
